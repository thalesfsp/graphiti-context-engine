{
  "name": "@thalesfsp/graphiti-context-engine",
  "version": "1.0.0",
  "description": "OpenClaw Context Engine plugin for Graphiti knowledge graph integration",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist",
    "openclaw.plugin.json",
    "README.md",
    "LICENSE"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/thalesfsp/graphiti-context-engine.git"
  },
  "bugs": {
    "url": "https://github.com/thalesfsp/graphiti-context-engine/issues"
  },
  "homepage": "https://github.com/thalesfsp/graphiti-context-engine#readme",
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc",
    "test": "vitest run",
    "dev": "vitest",
    "preview": "vitest --ui",
    "prepublishOnly": "npm run build && npm test"
  },
  "keywords": [
    "openclaw",
    "context-engine",
    "graphiti",
    "knowledge-graph",
    "neo4j",
    "memory",
    "ai",
    "llm"
  ],
  "author": "Thales FSP <thalesfsp@gmail.com>",
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^22.5.0",
    "typescript": "^5.6.2",
    "vitest": "^4.1.1"
  },
  "openclaw": {
    "extensions": [
      "./index.ts"
    ]
  }
}
